# Non-lab checklist example — copy values deliberately; do NOT apply blindly.
# Lab defaults stay cheap (rds_multi_az=false, enable_alb=false).

aws_region             = "us-east-1"
environment            = "staging"
aspnetcore_environment = "Production"
name_prefix            = "entitlex"

enable_nat_gateway      = true
enable_ecr              = true
enable_ecs_services     = true
enable_alb              = true
enable_alb_https        = false # set true + alb_certificate_arn for HTTPS
enable_lambda_schedules = false

rds_instance_class           = "db.t4g.small"
rds_allocated_storage_gb     = 50
rds_multi_az                 = true
rds_backup_retention_period  = 14

ses_from_address = "noreply@example.com"
app_base_url     = "https://entitlex.example.com"

# After deploy-aws push_images=true:
# container_image_api            = "123456789012.dkr.ecr.us-east-1.amazonaws.com/entitlex/api:staging"
# container_image_outbox         = "..."
# container_image_fulfillment    = "..."
# container_image_reconciliation = "..."
# container_image_notification   = "..."
# container_image_cloudshield    = "..."
# container_image_networkguard   = "..."
