# Copy to .env.local for local Vite (never commit real secrets).
# Keycloak (docker compose service on :8080)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/entitlex
VITE_OIDC_CLIENT_ID=entitlex-spa
# Optional: leave blank to use roles from the access token as configured in the IdP
VITE_OIDC_AUDIENCE=entitlex-api

# Show DevToken role picker (API must also have Jwt:EnableDevTokenEndpoint=true in Development)
VITE_ENABLE_DEV_TOKEN=true
