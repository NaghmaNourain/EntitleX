{
  "ConnectionStrings": {
    "CloudShield": "Host=localhost;Port=5432;Database=cloudshield;Username=entitlex;Password=entitlex"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "SimulatorAuth": {
    "ApiKey": "entitlex-lab-simulator-key-change-me",
    "HeaderName": "X-Api-Key"
  },
  "Messaging": {
    "Enabled": true,
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "cloudshield",
      "CloudShieldCommandsTopic": "cloudshield.license-extension.commands",
      "ProviderResultsTopic": "entitlex.provider.results",
      "CloudShieldConsumerGroup": "cloudshield-commands"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "CloudShield.Api",
    "OtlpEndpoint": "http://localhost:4317",
    "EnablePrometheusAspNetCore": true,
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
