{
  "ConnectionStrings": {
    "NetworkGuard": "Host=localhost;Port=5432;Database=networkguard;Username=entitlex;Password=entitlex"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "SimulatorAuth": {
    "ApiKey": "entitlex-lab-simulator-key-change-me",
    "HeaderName": "X-Api-Key"
  },
  "Messaging": {
    "Enabled": true,
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "networkguard",
      "NetworkGuardCommandsTopic": "networkguard.license-extension.commands",
      "ProviderResultsTopic": "entitlex.provider.results",
      "NetworkGuardConsumerGroup": "networkguard-commands"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
