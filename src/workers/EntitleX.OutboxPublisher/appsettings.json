{
  "ConnectionStrings": {
    "EntitleXPlatform": "Host=localhost;Port=5432;Database=entitlex_platform;Username=entitlex;Password=entitlex"
  },
  "Messaging": {
    "Sqs": {
      "ServiceUrl": "http://localhost:4566",
      "Region": "us-east-1",
      "AccessKey": "test",
      "SecretKey": "test",
      "FulfillmentQueueName": "entitlex-fulfillment",
      "FulfillmentDlqName": "entitlex-fulfillment-dlq",
      "VisibilityTimeoutSeconds": 30
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "entitlex-outbox"
    },
    "Outbox": {
      "BatchSize": 20,
      "PollIntervalMilliseconds": 1000,
      "LockDurationSeconds": 30,
      "MaxAttempts": 8,
      "BaseRetryDelaySeconds": 2,
      "MaxRetryDelaySeconds": 300
    }
  },
  "OpenTelemetry": {
    "ServiceName": "EntitleX.OutboxPublisher",
    "OtlpEndpoint": "http://localhost:4317",
    "EnablePrometheusAspNetCore": false,
    "PrometheusHttpListenerPrefixes": "http://localhost:9180/",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  }
}
